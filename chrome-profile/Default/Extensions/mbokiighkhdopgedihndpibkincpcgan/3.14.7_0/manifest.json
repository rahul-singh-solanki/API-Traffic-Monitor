{
   "$schema": "https://json.schemastore.org/chrome-manifest.json",
   "action": {
      "default_icon": {
         "128": "icon-128x128.png",
         "16": "icon-16x16.png",
         "48": "icon-48x48.png"
      }
   },
   "background": {
      "service_worker": "swWrapper.js"
   },
   "content_scripts": [ {
      "css": [ "swWarningContentScript.css" ],
      "js": [ "greenhouseSchedulerContentScript.js", "swWarningContentScript.js" ],
      "matches": [ "https://*.greenhouse.io/interviews/scheduler?*", "https://*.greenhouse.io/interviews/scheduler/legacy?*" ],
      "run_at": "document_start"
   }, {
      "js": [ "greenhouseCandidateContentScript.js", "greenhouseCandidateContentScriptV2.js" ],
      "matches": [ "https://*.greenhouse.io/people/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "drawerContentScript.css", "swWarningContentScript.css" ],
      "exclude_matches": [ "https://*.greenhouse.io/scorecards/*/confirmation" ],
      "js": [ "greenhouseDrawerContentScript.js", "swWarningContentScript.js" ],
      "matches": [ "https://*.greenhouse.io/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "button.css", "swWarningContentScript.css" ],
      "js": [ "greenhouseJdContentScript.js", "swWarningContentScript.js" ],
      "matches": [ "https://*.greenhouse.io/plans/*/ramp_up/job_post_index", "https://*.greenhouse.io/plans/*/ramp_up/job_post_edit", "https://*.greenhouse.io/plans/*/jobapps/new", "https://*.greenhouse.io/jobapps/*/edit" ],
      "run_at": "document_start"
   }, {
      "css": [ "button.css", "swWarningContentScript.css" ],
      "js": [ "greenhouseInterviewQuestionsContentScript.js", "swWarningContentScript.js" ],
      "matches": [ "https://*.greenhouse.io/guides/*/edit*", "https://*.greenhouse.io/ramp_up/guides/*/edit*" ],
      "run_at": "document_start"
   }, {
      "css": [ "button.css", "alert.css", "scorecard-ui.css", "feedback.css" ],
      "js": [ "greenhouseScorecardContentScript.js" ],
      "matches": [ "https://*.greenhouse.io/guides/*/people/*", "https://*.greenhouse.io/scorecards/*/edit" ],
      "run_at": "document_start"
   }, {
      "css": [ "drawerContentScript.css", "swWarningContentScript.css", "button.css", "alert.css", "scorecard-ui.css", "feedback.css" ],
      "js": [ "gemDrawerContentScript.js", "gemScorecardContentScript.js", "gemJdContentScript.js", "gemQuestionsContentScript.js", "swWarningContentScript.js" ],
      "matches": [ "https://www.gem.com/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "drawerContentScript.css", "swWarningContentScript.css" ],
      "js": [ "leverDrawerContentScript.js", "swWarningContentScript.js" ],
      "matches": [ "https://hire.lever.co/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "button.css", "alert.css", "scorecard-ui.css", "feedback.css" ],
